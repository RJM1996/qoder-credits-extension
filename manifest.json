{
  "manifest_version": 3,
  "name": "Qoder 积分用量",
  "version": "1.0.0",
  "description": "查看 Qoder 积分用量和花费明细",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://qoder.com/*"
  ]
}
